{
  "name": "onemail-docs",
  "version": "0.1.0",
  "private": true,
  "description": "OneMail Docs web editor.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:docs": "pnpm --filter @office/docs dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.3.3",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3"
  }
}
